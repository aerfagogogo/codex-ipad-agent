# Mimitag 自有分支适配；敏感签名材料只存在本机 Secrets 文件。
IOS_RELEASE_PROJECT_ID=mimitag
IOS_RELEASE_ENTRYPOINT=scripts/ios_testflight_ci.sh
IOS_RELEASE_REQUIRED_BRANCH=product/remote-ops-fast-history

# 渐进接入 asc：off 不调用；shadow 只记录差异；enforce 才把差异作为门禁。
# 本地默认保持关闭，可在仓库外 secrets.env 中覆盖为 shadow。
IOS_ASC_BUILD_NUMBER_MODE=off

IOS_BUNDLE_ID=com.aerfagogogo.mimitag
IOS_WIDGET_BUNDLE_ID=com.aerfagogogo.mimitag.carstatuswidget
IOS_APP_GROUP_ID=group.com.aerfagogogo.mimitag
DEVELOPMENT_TEAM=FT75GFXD73
IOS_PROVISIONING_PROFILE_ID=X7ATRF4YBV
IOS_EXPECTED_PROVISIONING_PROFILE_NAME='Mimitag App Store CI'
IOS_WIDGET_PROVISIONING_PROFILE_ID=4KKWXL8PJC
IOS_WIDGET_EXPECTED_PROVISIONING_PROFILE_NAME='Mimitag Widget App Store CI'
# 不固定 beta App 名称，始终使用 xcode-select 当前选中的、可被 ASC 接收的 Xcode。

TESTFLIGHT_BETA_GROUP_NAME='Mimitag Internal'
TESTFLIGHT_BETA_GROUP_ID=dc8f9844-ebbb-44ae-9d87-473427588d2a
TESTFLIGHT_MIN_TESTERS=1
TESTFLIGHT_INVITE_PENDING_TESTERS=0
TESTFLIGHT_EXTERNAL_BETA_GROUP_NAME='Mimitag External'
TESTFLIGHT_EXTERNAL_BETA_GROUP_ID=f1574ed1-a08c-45ee-941b-7132c54709a7
TESTFLIGHT_EXTERNAL_AUTO_SUBMIT=1
TESTFLIGHT_EXTERNAL_AUTO_NOTIFY=1
TESTFLIGHT_MIN_EXTERNAL_TESTERS=2
TESTFLIGHT_STATUS_TIMEOUT_SECONDS=1800
TESTFLIGHT_STATUS_INTERVAL_SECONDS=15
